<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0d0d1a">
<title>NEON_SURGE</title>
<style>
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0}
body{
 background:#0d0d1a;color:#00ffff;
 font-family:"Courier New",Courier,monospace;
 display:flex;justify-content:center;align-items:center;
 min-height:100vh;min-height:100dvh;overflow:hidden;
 cursor:pointer;text-align:center;user-select:none;
 -webkit-tap-highlight-color:transparent;
 transition:background-color .5s ease
}
body.is-active{background:#000!important;cursor:default}
.container{
 width:min(92vw,650px);border:2px solid #ff007f;padding:clamp(24px,6vw,40px);
 box-shadow:0 0 15px #ff007f, inset 0 0 18px #ff007f22;
 border-radius:8px;transition:opacity .5s ease;
 animation:neonPulse 2.8s ease-in-out infinite
}
.hidden{display:none!important}
h1{font-size:clamp(2.15rem,9vw,3rem);text-shadow:0 0 10px #00ffff,0 0 24px #00ffff66;margin:0 0 5px;letter-spacing:.06em}
.sub{color:#ff007f;font-size:.9rem;margin-bottom:30px;text-shadow:0 0 8px #ff007f}
.start-btn{
 border:1px solid #00ffff;padding:15px 18px;display:inline-block;margin-top:20px;
 box-shadow:0 0 10px #00ffff,inset 0 0 12px #00ffff22;
 max-width:100%;animation:buttonPulse 1.8s ease-in-out infinite
}
.start-btn h2{font-size:clamp(.95rem,4vw,1.25rem);margin:0 0 10px}
.start-btn p{font-size:clamp(.72rem,3vw,.85rem);margin:0;line-height:1.5;color:#b9ffff}
.footer{margin-top:30px;font-size:.8rem;opacity:.7;letter-spacing:.08em}
body.is-active .container{display:none}
@keyframes neonPulse{50%{box-shadow:0 0 25px #ff007f,inset 0 0 22px #ff007f33}}
@keyframes buttonPulse{50%{box-shadow:0 0 20px #00ffff,inset 0 0 16px #00ffff33}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<main class="container" id="app-container">
 <h1>NEON_SURGE</h1>
 <div class="sub">SYSTEM ID: #994-ALPHA</div>
 <div class="start-btn">
  <h2>[ PRESS ANYWHERE TO START ]</h2>
  <p>Tap anywhere to initialize audio subsystem &amp; launch</p>
 </div>
 <div class="footer">ARCADE INTERACTIVE // MULTI-USER ACCESS</div>
</main>
<audio id="bg-audio" loop preload="auto">
 <source src="data:audio/mpeg;base64," type="audio/mpeg">
</audio>
<script>
let launched = false;
async function launchApp(){
 if(launched) return;
 launched = true;
 const audio = document.getElementById("bg-audio");
 audio.volume = 1;
 audio.currentTime = 0;
 try { await audio.play(); }
 catch(err) {
   launched = false;
   document.getElementById("app-container").querySelector("p").textContent =
     "Audio could not start. Tap anywhere again to retry.";
   console.error("Audio playback error:", err);
   return;
 }
 document.body.classList.add("is-active");
 document.getElementById("app-container").classList.add("hidden");
 const root = document.documentElement;
 try {
   if(root.requestFullscreen) await root.requestFullscreen();
   else if(root.webkitRequestFullscreen) root.webkitRequestFullscreen();
 } catch(err) { console.log("Fullscreen is not available in this browser:",err); }
}
document.addEventListener("pointerdown", launchApp, {once:false});
</script>
</body>
</html>
